# Copy this file to ".env" and fill in real values there.
# ".env" is ignored by Git. Never put real keys in this example file.

# Which data provider to use. v0.1 starts with "yfinance" (no key needed).
DATA_PROVIDER=yfinance

# Optional: where the local database lives (default: data/forex.db)
# FOREX_DB_PATH=data/forex.db

# --- OANDA Practice (demo) account: for later, leave empty for now ---
# Read-only use only: this project never places orders.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Telegram alerts: for a later version, leave empty for now ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
