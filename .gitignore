# --- Secrets: never commit real keys or tokens ---
.env
.env.*
!.env.example

# --- Local market data (re-downloadable, can get large) ---
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# --- Python virtual environment ---
.venv/
venv/

# --- Python build/cache files ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# --- Dashboard (React) downloads and build output: recreated by npm install / npm run build ---
web/node_modules/
web/dist/

# --- Logs ---
logs/
*.log

# --- Claude Code local preview settings (contain this PC's paths) ---
.claude/launch.json

# --- Editor / OS files ---
.vscode/
.idea/
Thumbs.db
.DS_Store
